# Copy to .env (compose reads it). Never commit .env.
PG_PASSWORD=change-me-strong
ADMIN_SESSION_SECRET=generate-with-openssl-rand-base64-36-at-least-32-chars
# argon2 PHC hash. IMPORTANT: compose interpolates this file, so DOUBLE every $
# (write $$argon2id$$v=19$$...); compose un-doubles it to a single $ in the
# container. `npm run admin:set-password` prints the single-$ form to escape.
ADMIN_PASSWORD_HASH=$$argon2id$$...
SITE_URL=https://furkanunsalan.dev
GITHUB_TOKEN=
GITHUB_TOKEN_WORK=
GITHUB_USERNAME_WORK=furkanunsalan-teachfluence
KARAKEEP_API_KEY=
UNSPLASH_ACCESS_KEY=
