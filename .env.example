# Copy to .env (compose reads it). Never commit .env.
PG_PASSWORD=change-me-strong
ADMIN_SESSION_SECRET=generate-with-openssl-rand-base64-36-at-least-32-chars
ADMIN_PASSWORD_HASH=$argon2id$...   # plain PHC hash (no \$ escaping); `npm run admin:set-password` prints one
SITE_URL=https://furkanunsalan.dev
GITHUB_TOKEN=
GITHUB_TOKEN_WORK=
GITHUB_USERNAME_WORK=furkanunsalan-teachfluence
KARAKEEP_API_KEY=
