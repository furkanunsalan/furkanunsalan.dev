{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "verbatimModuleSyntax": false
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "components/**/*",
    "lib/**/*",
    "db/**/*",
    "types/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
