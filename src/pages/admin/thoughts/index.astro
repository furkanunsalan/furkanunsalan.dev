---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import RestoreScroll from "@/components/admin/RestoreScroll";
import { desc, isNull } from "drizzle-orm";
import { db, schema } from "@/lib/db";

export const prerender = false;

function truncate(s: string, n: number): string {
  const t = s.replace(/\s+/g, " ").trim();
  if (t.length <= n) return t;
  return t.slice(0, n).trimEnd() + "…";
}

const rows = await db
  .select()
  .from(schema.thoughts)
  .where(isNull(schema.thoughts.deletedAt))
  .orderBy(desc(schema.thoughts.createdAt));
---

<AdminLayout title="Thoughts · admin">
  <div>
    <RestoreScroll storageKey="admin:thoughts:scroll" client:load />

    <header class="mb-6 flex items-end justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2 min-w-0">
          <h1 class="text-xl font-semibold tracking-tight truncate">Thoughts</h1>
        </div>
        <p class="mt-1 text-xs text-light-fourth">{rows.length} entries.</p>
      </div>
      <a
        href="/admin/thoughts/new"
        class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs bg-accent-primary/15 text-accent-primary ring-1 ring-accent-primary/40 hover:bg-accent-primary/25 transition-colors"
      >
        <svg
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="M12 5v14"></path>
        </svg>
        New thought
      </a>
    </header>

    <ul
      class="divide-y divide-white/[0.04] ring-1 ring-white/[0.06] rounded-xl overflow-hidden bg-zinc-950"
    >
      {
        rows.length === 0 && (
          <li class="px-4 py-6 text-sm text-light-fourth text-center">
            No thoughts yet.
          </li>
        )
      }
      {
        rows.map((t) => {
          const imageCount = (t.images || []).length;
          const preview = truncate(t.body || "", 140) || "(no body)";
          return (
            <li>
              <a
                href={`/admin/thoughts/${t.id}`}
                class="block px-4 py-3 hover:bg-white/[0.03] transition-colors"
              >
                <div class="flex items-center gap-3">
                  <svg
                    class="w-4 h-4 text-light-fourth shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                  </svg>
                  <div class="min-w-0 flex-1">
                    <div class="text-sm text-white truncate flex items-center gap-2">
                      <span class="truncate">{preview}</span>
                      {t.draft && (
                        <span class="shrink-0 inline-flex items-center rounded-full px-2 py-[3px] text-[10px] leading-none uppercase tracking-wider ring-1 ring-amber-400/40 bg-amber-400/10 text-amber-300">
                          draft
                        </span>
                      )}
                    </div>
                    {t.tags.length > 0 && (
                      <div class="mt-1 flex flex-wrap gap-1">
                        {t.tags.slice(0, 6).map((tag) => (
                          <span class="rounded-full px-2 py-0.5 text-[10px] ring-1 ring-white/[0.06] text-light-fourth">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                  <div class="shrink-0 flex items-center gap-2 text-light-fourth">
                    {imageCount > 0 && (
                      <span
                        class="inline-flex items-center gap-1 text-[11px]"
                        title={`${imageCount} image${imageCount === 1 ? "" : "s"}`}
                      >
                        <svg
                          class="w-3.5 h-3.5"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                          <circle cx="9" cy="9" r="2" />
                          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                        </svg>
                        <span class="tabular-nums">{imageCount}</span>
                      </span>
                    )}
                    <time class="text-xs tabular-nums">
                      {t.createdAt.toISOString().slice(0, 10)}
                    </time>
                  </div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</AdminLayout>
