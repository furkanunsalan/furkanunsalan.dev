---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { asc, isNull } from "drizzle-orm";
import { db, schema } from "@/lib/db";
import RestoreScroll from "@/components/admin/RestoreScroll";
import GithubVisibilityEditor from "@/components/admin/GithubVisibilityEditor";

export const prerender = false;

const [rows, ghRows] = await Promise.all([
  db
    .select()
    .from(schema.projects)
    .where(isNull(schema.projects.deletedAt))
    .orderBy(asc(schema.projects.order)),
  db
    .select()
    .from(schema.githubProjectVisibility)
    .orderBy(
      asc(schema.githubProjectVisibility.pinOrder),
      asc(schema.githubProjectVisibility.name),
    ),
]);
---

<AdminLayout title="Projects · admin">
  <div class="space-y-10">
    <RestoreScroll storageKey="admin:projects:scroll" client:load />

    <section>
      <header class="mb-6 flex items-end justify-between gap-4">
        <div class="min-w-0">
          <div class="flex items-center gap-2 min-w-0">
            <h1 class="text-xl font-semibold tracking-tight truncate">
              Projects
            </h1>
          </div>
          <p class="mt-1 text-xs text-light-fourth">
            {rows.length} custom entries. Sorted by order field.
          </p>
        </div>
        <a
          href="/admin/projects/new"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs bg-accent-primary/15 text-accent-primary ring-1 ring-accent-primary/40 hover:bg-accent-primary/25 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14"></path>
            <path d="M12 5v14"></path>
          </svg>
          New project
        </a>
      </header>
      <ul
        class="divide-y divide-white/[0.04] ring-1 ring-white/[0.06] rounded-xl overflow-hidden bg-zinc-950"
      >
        {
          rows.length === 0 && (
            <li class="px-4 py-6 text-sm text-light-fourth text-center">
              No custom projects yet.
            </li>
          )
        }
        {
          rows.map((p) => (
            <li>
              <a
                href={`/admin/projects/${encodeURIComponent(p.slug)}`}
                class="block px-4 py-3 hover:bg-white/[0.03] transition-colors"
              >
                <div class="flex items-center gap-3">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 text-light-fourth shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v.5" />
                    <path d="M14 19c-2.8 0-5-2.2-5-5v8" />
                    <circle cx="13" cy="12" r="2" />
                    <circle cx="20" cy="19" r="2" />
                  </svg>
                  <div class="min-w-0 flex-1">
                    <div class="text-sm text-white truncate">{p.name}</div>
                    <div class="text-xs text-light-fourth truncate">
                      {p.description || "—"}
                    </div>
                    <div class="text-[10px] text-light-fourth/70 mt-1 uppercase tracking-wider">
                      order {p.order}
                      {p.language ? ` · ${p.language}` : ""}
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="github" class="scroll-mt-16">
      <header class="mb-4">
        <h2 class="text-base font-semibold tracking-tight">GitHub repos</h2>
        <p class="mt-1 text-xs text-light-fourth">
          Which repos appear on /projects, and which are pinned to the top. Sync
          re-imports the live repo list while preserving your toggles.
        </p>
      </header>
      <GithubVisibilityEditor initial={ghRows} client:load />
    </section>
  </div>
</AdminLayout>
