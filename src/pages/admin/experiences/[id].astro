---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ExperienceForm from "@/components/admin/ExperienceForm";
import { eq } from "drizzle-orm";
import { db, schema } from "@/lib/db";

export const prerender = false;

const { id } = Astro.params;
const [row] = await db
  .select()
  .from(schema.experiences)
  .where(eq(schema.experiences.id, id!))
  .limit(1);

if (!row) {
  return new Response("Not found", { status: 404 });
}

const initial = {
  id: row.id,
  order: row.order,
  organization: row.organization,
  title: row.title,
  startDate: String(row.startDate),
  endDate: row.endDate ? String(row.endDate) : "",
  comment: row.comment,
  logo: row.logo ?? "",
  links: row.links,
  images: row.images,
};
---

<AdminLayout title={`${row.title} @ ${row.organization} · admin`}>
  <div>
    <header class="mb-6 flex items-end justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2 min-w-0">
          <a
            href="/admin/experiences"
            aria-label="Back"
            class="inline-flex items-center justify-center w-7 h-7 rounded-md ring-1 ring-white/[0.08] text-light-secondary hover:text-white hover:ring-white/20 transition-colors shrink-0"
          >
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
          </a>
          <h1 class="text-xl font-semibold tracking-tight truncate">
            {row.title} @ {row.organization}
          </h1>
        </div>
        <p class="mt-1 text-xs text-light-fourth">{row.id}</p>
      </div>
    </header>
    <ExperienceForm mode="edit" initial={initial} client:load />
  </div>
</AdminLayout>
