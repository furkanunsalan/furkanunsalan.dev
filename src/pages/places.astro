---
import PageLayout from "../layouts/PageLayout.astro";
import PlacesMap from "@/components/PlacesMap";
import PlacesList from "@/components/PlacesList";
import { getPlaces, getPlaceLists } from "@/lib/content";

export const prerender = false;
const [places, lists] = await Promise.all([getPlaces(), getPlaceLists()]);
---

<PageLayout
  title="Places | Furkan Ünsalan"
  description="A self-owned map of places I've curated — no Google data dependencies at runtime."
>
  <div class="mt-24 mb-16 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 animate-fade-in">
    {
      places.length === 0 ? (
        <div class="rounded-xl ring-1 ring-white/[0.06] bg-zinc-950 p-6 text-sm text-light-fourth">
          No places yet. Add one in{" "}
          <code class="text-accent-primary">/admin/places/new</code>.
        </div>
      ) : (
        <>
          {/* Two islands, not one. The map must be client-only (Leaflet touches
              `window` at import time), but the list does not need it — so the
              list is server-rendered and its content is in the HTML before any
              JS runs, instead of waiting on the ~128 KB that also carries
              Leaflet. A row click reaches the map over lib/places-select. */}
          <PlacesMap places={places} lists={lists} client:only="react" />
          <div class="mt-10">
            <PlacesList places={places} lists={lists} client:load />
          </div>
        </>
      )
    }
  </div>
</PageLayout>
