---
import PageLayout from "../../layouts/PageLayout.astro";
import PostBody from "@/components/PostBody";
import { getPostContentBySlug } from "@/lib/content";
import { getRelatedPosts } from "@/lib/search";

export const prerender = false;

const { slug } = Astro.params;
const post = slug ? await getPostContentBySlug(slug) : null;
// rewrite, not redirect: keeps the requested URL so /404 can suggest
// near-matches, and answers with a real 404 status instead of a 302.
if (!post) {
  return Astro.rewrite(`/404?from=/writing/${encodeURIComponent(slug ?? "")}`);
}

const SITE_BASE =
  process.env.NEXT_PUBLIC_SITE_URL || "https://furkanunsalan.dev";

const formattedDate = new Date(post.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const words = post.content.split(/\s+/).filter(Boolean).length;
const readingTime = `${Math.max(1, Math.ceil(words / 200))} min read`;

const postUrl = `${SITE_BASE}/writing/${post.slug}`;

const related = await getRelatedPosts(post.slug, post.title, post.tags, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: post.title,
      datePublished: new Date(post.date).toISOString(),
      dateModified: new Date(post.date).toISOString(),
      author: {
        "@type": "Person",
        name: "Furkan Ünsalan",
        url: SITE_BASE,
      },
      mainEntityOfPage: postUrl,
      url: postUrl,
      ...(post.tags?.length ? { keywords: post.tags.join(", ") } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: SITE_BASE },
        {
          "@type": "ListItem",
          position: 2,
          name: "Writing",
          item: `${SITE_BASE}/writing`,
        },
        { "@type": "ListItem", position: 3, name: post.title, item: postUrl },
      ],
    },
  ],
};
---

<PageLayout
  title={`${post.title} | Furkan Ünsalan`}
  description={post.excerpt || post.title}
  image={`/og/writing/${post.slug}.png`}
  ogType="article"
  navMaxWidth="max-w-6xl"
>
  <div class="mt-24 mb-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <header class="mb-8 animate-fade-in-up">
      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-2">
        {post.title}
      </h1>
      <div class="text-xs sm:text-sm text-light-fourth">
        <time>{formattedDate}</time>
        <span class="mx-2">•</span>
        <span>{readingTime}</span>
      </div>

      {
        post.tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {post.tags.map((tag) => (
              <li>
                <span class="chip">{tag}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        post.banner && (
          <img
            src={post.banner}
            alt={post.title}
            sizes="(max-width: 1024px) 100vw, 768px"
            class="mt-6 max-h-[420px] w-auto h-auto max-w-full rounded-xl ring-1 ring-white/[0.06] animate-fade-in delay-100"
          />
        )
      }
    </header>

    <PostBody content={post.content} client:only="react" />

    {
      related.length > 0 && (
        <aside class="mt-16 border-t border-white/[0.06] pt-8">
          <h2 class="text-xs uppercase tracking-wider text-light-fourth">
            Related
          </h2>
          <ul class="mt-4 divide-y divide-white/[0.06]">
            {related.map((r) => (
              <li>
                <a
                  href={`/writing/${r.slug}`}
                  class="group block py-4 transition-colors"
                >
                  <span class="text-sm text-white transition-colors group-hover:text-accent-primary">
                    {r.title}
                  </span>
                  {r.excerpt && (
                    <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-light-fourth">
                      {r.excerpt}
                    </p>
                  )}
                  <span class="mt-1.5 block text-[10px] uppercase tracking-wider text-light-fourth">
                    <time datetime={r.date}>
                      {new Date(r.date).toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                    {r.tags.length > 0 && (
                      <span class="normal-case tracking-normal opacity-70">
                        {" · "}
                        {r.tags.join(" · ")}
                      </span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</PageLayout>
