---
import PageLayout from "../layouts/PageLayout.astro";
import ResumePdfPages from "@/components/ResumePdfPages";

export const prerender = false;

const variant =
  Astro.url.searchParams.get("variant") === "short" ? "short" : "full";
---

<PageLayout
  title="Resume | Furkan Ünsalan"
  description="Furkan Ünsalan's resume — short and full versions."
>
  <div class="mt-24 pb-24 min-h-screen max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="mb-6 flex items-center justify-between gap-4 animate-fade-in-down"
    >
      <div class="inline-flex rounded-lg border border-white/[0.08] p-0.5 text-sm">
        <a
          href="/resume?variant=short"
          class={`rounded-md px-3 py-1 transition-colors duration-200 ${
            variant === "short"
              ? "bg-accent-primary/15 text-accent-primary"
              : "text-light-fourth hover:text-light-secondary"
          }`}>Short</a
        >
        <a
          href="/resume?variant=full"
          class={`rounded-md px-3 py-1 transition-colors duration-200 ${
            variant === "full"
              ? "bg-accent-primary/15 text-accent-primary"
              : "text-light-fourth hover:text-light-secondary"
          }`}>Full</a
        >
      </div>
      <a
        href={`/api/cv?variant=${variant}&download=1`}
        class="inline-flex items-center gap-1.5 rounded-lg border border-white/[0.08] bg-zinc-950 px-3 py-1.5 text-sm text-light-secondary transition-colors duration-200 hover:border-accent-primary/50 hover:text-accent-primary"
      >
        <svg
          class="h-3.5 w-3.5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" x2="12" y1="15" y2="3"></line>
        </svg>
        Download
      </a>
    </div>

    <div class="animate-fade-in">
      <ResumePdfPages src={`/api/cv?variant=${variant}`} client:only="react" />
    </div>
  </div>
</PageLayout>
