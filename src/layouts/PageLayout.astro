---
import Layout from "./Layout.astro";
import SiteNav from "@/components/SiteNav";
import CoastCipher from "@/components/CoastCipher";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  ogType?: "website" | "article";
  navMaxWidth?: string;
}
const { title, description, noindex, image, ogType, navMaxWidth } = Astro.props;
---

<Layout
  title={title}
  description={description}
  noindex={noindex}
  image={image}
  ogType={ogType}
>
  <slot name="head" slot="head" />
  <SiteNav
    maxWidth={navMaxWidth}
    initialPathname={Astro.url.pathname}
    client:idle
  />
  <slot />
  <CoastCipher client:idle />
</Layout>
