---
import Layout from "./Layout.astro";
import SiteNav from "@/components/SiteNav";
import CoastCipher from "@/components/CoastCipher";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  ogType?: "website" | "article";
  navMaxWidth?: string;
  /** Skip the coast band. `/bookmarks` is a full-viewport fixed canvas, so a
   *  band that slides up from the bottom has nowhere to go but over the graph. */
  noFooter?: boolean;
}
const {
  title,
  description,
  noindex,
  image,
  ogType,
  navMaxWidth,
  noFooter = false,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  noindex={noindex}
  image={image}
  ogType={ogType}
>
  <slot name="head" slot="head" />
  <SiteNav
    maxWidth={navMaxWidth}
    initialPathname={Astro.url.pathname}
    client:idle
  />
  <slot />
  {!noFooter && <CoastCipher client:idle />}
</Layout>
